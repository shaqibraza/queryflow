generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String         @unique
  passwordHash  String
  avatar        String?
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  isRevoked Boolean  @default(false)
  device    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Dataset {
  id          String   @id @default(cuid())

  name        String
  description String?

  ownerId     String

  fileName    String
  fileType    String
  fileSize    Int

  storageKey  String

  status      DatasetStatus @default(UPLOADED)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DatasetStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}