generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String         @unique
  passwordHash  String
  avatar        String?
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  isRevoked Boolean  @default(false)
  device    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
}

model DatabaseConnection {
  id            String        @id @default(cuid())

  name          String
  databaseType  DatabaseType

  encryptedUrl  String

  ownerId       String

  isActive      Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ownerId])
}


model Conversation {
  id           String    @id @default(cuid())

  userId       String

  connectionId String

  title        String

  messages     Message[]

  createdAt    DateTime  @default(now())

  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([connectionId])
}


model Message {
  id             String   @id @default(cuid())

  conversationId String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           MessageRole

  question       String?

  reply          String?

  generatedQuery String?

  analysis       Json?

  result         Json?

  createdAt      DateTime @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
}